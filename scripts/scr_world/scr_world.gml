// scr_world - scene runtime: collision grid, movement, spawning and scene-pass transitions.
// Scene data comes from datafiles/data/scenes/<room>.json, generated by tools/build_scenes.py
// from design/desert/scenes/*.json + scene_gameplay_specs.json + scene_decorations.json.
// Terrain classes: . , ; _ ^ = | walkable; ~ C x block walking only; # M block everything.

function world_active() {
    if (!variable_global_exists("ui")) return false;
    if (global.mode != MODE.PLAY) return false;
    if (array_length(global.ui.stack) > 0) return false;
    if (is_struct(global.transition)) return false;
    if (global.cine_lock) return false;   // in-scene cinematics suspend simulation; their owners keep animating
    return true;
}

/// Cinematic-owned actors (cutscene puppets, defeat sequence) may animate while the world is suspended.
function cinematic_active() {
    return global.mode == MODE.CINEMA || global.cine_lock;
}

function world_build(_sc) {
    world_free();
    var _w = _sc.w;
    var _h = _sc.h;
    global.world = {
        w: _w, h: _h,
        grid: ds_grid_create(_w, _h),
        dyn: ds_grid_create(_w, _h),
        mp: mp_grid_create(0, 0, _w, _h, TILE, TILE)
    };
    var _g = global.world.grid;
    ds_grid_clear(_g, CELL.WALK);
    ds_grid_clear(global.world.dyn, 0);
    for (var _y = 0; _y < _h; _y++) {
        var _row = _sc.terrain[_y];
        for (var _x = 0; _x < _w; _x++) {
            var _b = string_byte_at(_row, _x + 1);
            var _c = CELL.WALK;
            switch (_b) {
                case 35: case 77: _c = CELL.SOLID; break;            // # M
                case 126: case 67: case 120: _c = CELL.LOW; break;   // ~ C x
            }
            if (_c != CELL.WALK) {
                _g[# _x, _y] = _c;
                mp_grid_add_cell(global.world.mp, _x, _y);
            }
        }
    }
}

function world_free() {
    if (!variable_global_exists("world") || !is_struct(global.world)) return;
    if (ds_exists(global.world.grid, ds_type_grid)) ds_grid_destroy(global.world.grid);
    if (ds_exists(global.world.dyn, ds_type_grid)) ds_grid_destroy(global.world.dyn);
    mp_grid_destroy(global.world.mp);
    global.world = undefined;
}

function world_ready() {
    return variable_global_exists("world") && is_struct(global.world);
}

/// Collision class of a cell, including closed barriers. Outside the scene counts as solid.
function world_cell(_cx, _cy) {
    if (!world_ready()) return CELL.WALK;
    var _w = global.world;
    if (_cx < 0 || _cy < 0 || _cx >= _w.w || _cy >= _w.h) return CELL.SOLID;
    return max(_w.grid[# _cx, _cy], _w.dyn[# _cx, _cy]);
}

function world_walkable_px(_px, _py) {
    return world_cell(floor(_px / TILE), floor(_py / TILE)) == CELL.WALK;
}

function world_proj_blocked_px(_px, _py) {
    return world_cell(floor(_px / TILE), floor(_py / TILE)) == CELL.SOLID;
}

/// Closes/opens barrier cells (gates). Closed barriers block walking and projectiles.
function world_set_barrier(_rect, _closed) {
    if (!world_ready()) return;
    for (var _x = _rect[0]; _x <= _rect[2]; _x++) {
        for (var _y = _rect[1]; _y <= _rect[3]; _y++) {
            global.world.dyn[# _x, _y] = _closed ? CELL.SOLID : 0;
            if (_closed) mp_grid_add_cell(global.world.mp, _x, _y);
            else if (global.world.grid[# _x, _y] == CELL.WALK) mp_grid_clear_cell(global.world.mp, _x, _y);
        }
    }
}

/// Instance scope: can the collision mask stand at (nx, ny)?
function actor_free_at(_nx, _ny) {
    var _l = _nx + (bbox_left - x);
    var _r = _nx + (bbox_right - x);
    var _t = _ny + (bbox_top - y);
    var _b = _ny + (bbox_bottom - y);
    if (!world_walkable_px(_l, _t) || !world_walkable_px(_r, _t)) return false;
    if (!world_walkable_px(_l, _b) || !world_walkable_px(_r, _b)) return false;
    if (!world_walkable_px((_l + _r) / 2, _t) || !world_walkable_px((_l + _r) / 2, _b)) return false;
    if (place_meeting(_nx, _ny, obj_collision_parent)) return false;
    return true;
}

/// Instance scope: axis-separated movement with sliding. Returns distance actually moved.
function actor_move(_dx, _dy) {
    var _sx = x;
    var _sy = y;
    var _steps = max(1, ceil(max(abs(_dx), abs(_dy)) / 4));
    var _ix = _dx / _steps;
    var _iy = _dy / _steps;
    for (var i = 0; i < _steps; i++) {
        if (_ix != 0) {
            if (actor_free_at(x + _ix, y)) x += _ix;
            else {
                var _p = sign(_ix);
                while (abs(_p) <= abs(_ix) && actor_free_at(x + _p, y)) _p += sign(_ix);
                x += _p - sign(_ix);
                _ix = 0;
            }
        }
        if (_iy != 0) {
            if (actor_free_at(x, y + _iy)) y += _iy;
            else {
                var _q = sign(_iy);
                while (abs(_q) <= abs(_iy) && actor_free_at(x, y + _q)) _q += sign(_iy);
                y += _q - sign(_iy);
                _iy = 0;
            }
        }
    }
    return point_distance(_sx, _sy, x, y);
}

/// Line of sight for ranged attackers: cliffs, masonry and closed barriers block it.
function world_los(_x1, _y1, _x2, _y2) {
    var _d = point_distance(_x1, _y1, _x2, _y2);
    var _n = max(1, ceil(_d / 16));
    for (var i = 1; i < _n; i++) {
        var _t = i / _n;
        if (world_proj_blocked_px(lerp(_x1, _x2, _t), lerp(_y1, _y2, _t))) return false;
    }
    return true;
}

/// Surface under a ground point for footsteps: "sand", "stone" or "wood".
function world_surface(_px, _py) {
    if (!is_struct(global.scene)) return "sand";
    var _cx = floor(_px / TILE);
    var _cy = floor(_py / TILE);
    if (_cy < 0 || _cy >= global.scene.h || _cx < 0 || _cx >= global.scene.w) return "sand";
    var _b = string_byte_at(global.scene.terrain[_cy], _cx + 1);
    if (_b == 61 || _b == 124) return "wood";       // = |
    if (_b == 95 || _b == 94) return "stone";       // _ ^
    return "sand";
}

function place_name_at(_cx, _cy) {
    if (!is_struct(global.scene)) return "";
    var _p = global.scene.places;
    for (var i = 0; i < array_length(_p); i++) if (rect_has_cell(_p[i].rect, _cx, _cy)) return _p[i].name;
    return global.scene.name;
}

// ------------------------------------------------------------------ spawning
function scene_spawn_all(_sc) {
    var _dep_flat = 150;
    var i;
    var _props = array_or(_sc.props);
    for (i = 0; i < array_length(_props); i++) {
        var _pr = _props[i];
        instance_create_depth(cell_px(_pr.cell[0]), cell_px(_pr.cell[1]), 0, obj_prop,
            { prop_id: _pr.prop, spr: asset_or(_pr.sprite, asset_or(_pr.sprite_ph, spr_ph_prop)), fp_w: _pr.fp[0], fp_h: _pr.fp[1] });
    }
    var _decor = array_or(_sc.decor);
    for (i = 0; i < array_length(_decor); i++) {
        var _de = _decor[i];
        instance_create_depth(cell_px(_de.cell[0]) + _de.off[0], cell_px(_de.cell[1]) + _de.off[1],
            _de.flat ? _dep_flat : 0, obj_deco, { spr: asset_or(_de.sprite, asset_or(_de.sprite_ph, -1)), flat: _de.flat, deco_id: _de.id });
    }
    var _chests = array_or(_sc.chests);
    for (i = 0; i < array_length(_chests); i++) {
        var _ch = _chests[i];
        instance_create_depth(cell_px(_ch.cell[0]), cell_px(_ch.cell[1]), 0, obj_chest,
            { chest_id: _ch.id, loot_all: _ch.loot });
    }
    var _cps = array_or(_sc.checkpoints);
    for (i = 0; i < array_length(_cps); i++) {
        var _cp = _cps[i];
        instance_create_depth(cell_px(_cp.cell[0]), cell_px(_cp.cell[1]), 0, obj_checkpoint,
            { cp_id: _cp.id, respawn: _cp.respawn, location: _cp.location, safe_rect: _cp.safe });
    }
    var _en = array_or(_sc.enemies);
    for (i = 0; i < array_length(_en); i++) {
        var _e = _en[i];
        if (_e.family == "pharaoh") continue;  // the boss controller owns the Pharaoh
        if (struct_or(global.run.defeated, _e.id, false)) continue;
        instance_create_depth(cell_px(_e.cell[0]), cell_px(_e.cell[1]), 0, obj_enemy,
            { spawn_id: _e.id, family: _e.family, leash: _e.leash, persistent_spawn: true });
    }
    var _ex = array_or(_sc.exits);
    for (i = 0; i < array_length(_ex); i++) {
        instance_create_depth(0, 0, 0, obj_exit, { exit_data: _ex[i] });
    }
    var _scripts = array_or(_sc.scripts);
    for (i = 0; i < array_length(_scripts); i++) {
        var _s = _scripts[i];
        if (_s.event == "interact_heal") {
            var _r = _s.rect;
            instance_create_depth(cell_px((_r[0] + _r[2]) / 2), cell_px(_r[3]), 0, obj_spring, { rect: _r });
        }
    }
    if (is_struct(_sc.boss)) {
        instance_create_depth(0, 0, 0, obj_boss_ctrl, { boss: _sc.boss, scripts: _scripts });
    }
}

// ------------------------------------------------------------------ transitions
/// Starts a fade-out, then loads the destination scene and places Dave at the arrival.
function scene_go(_room_name, _px, _py, _facing, _kind = "pass") {
    if (is_struct(global.transition)) return;
    global.transition = { phase: "out", t: 0, len: 18, room: _room_name, kind: _kind };
    global.pending_arrival = { x: _px, y: _py, facing: _facing, kind: _kind };
    global.damage_paused = true;
    with (obj_projectile) instance_destroy();
    with (obj_hazard) instance_destroy();
    inp_block_all();
}

function transition_step() {
    var _t = global.transition;
    if (!is_struct(_t)) return;
    _t.t += 1;
    if (_t.phase == "out" && _t.t >= _t.len) {
        _t.phase = "load";
        aud_stop_world(80);
        var _rm = asset_get_index(_t.room);
        if (_rm < 0) {
            show_debug_message("missing room " + _t.room);
            global.transition = undefined;
            global.damage_paused = false;
            return;
        }
        room_goto(_rm);
    } else if (_t.phase == "in" && _t.t >= _t.len) {
        global.transition = undefined;
        if (!global.cine_lock) global.damage_paused = false;
        inp_block_all();
    }
}

/// Called from obj_game Room Start.
function transition_room_started() {
    var _t = global.transition;
    if (is_struct(_t) && _t.phase == "load") {
        _t.phase = "in";
        _t.t = 0;
        global.fade_black = 0;
    }
}

function transition_alpha() {
    var _t = global.transition;
    if (!is_struct(_t)) return 0;
    if (_t.phase == "out") return _t.t / _t.len;
    if (_t.phase == "load") return 1;
    return 1 - _t.t / _t.len;
}
